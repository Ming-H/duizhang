# 对账 tally — 环境变量样例（复制为 .env 使用；.env 已 gitignore）
#
# 档位速查：
#   档位 0（默认）：本地 Ollama，零 key 零成本零外呼 —— 什么都不用填
#   档位 1：远端 OpenAI 兼容端点（填 KEY + BASE）
#   档位 2：Anthropic 兼容端点（填 KEY + BASE 指向 /v1/messages 端点，如 GLM Coding Plan）
#
# 注意：BASE 指向 localhost 时免 key（llm_enabled=True）；think 默认关
#（本地开 think 约 ×5 延迟）；Anthropic 兼容通道 thinking 计入 max_tokens，
# 预算自动 ×8。实测细节见 docs/DESIGN-v0.5.md D7。

# ── LLM（全部可选）──────────────────────────────────────
# 档位 1/2 必填；本地 Ollama 不需要。只存在于 .env，绝不进代码/git
TALLY_LLM_API_KEY=

# 档位 1 示例：OpenAI 兼容（bigmodel/任意 /v1/chat/completions 端点）
# TALLY_LLM_BASE_URL=http://localhost:11434/v1
# 档位 2 示例：Anthropic 兼容（_use_anthropic 自动识别）
# TALLY_LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 模型名：默认 qwen3.5:0.8b（本地）。远端示例：glm-4.7 / claude-sonnet-4-6
# TALLY_LLM_MODEL=qwen3.5:0.8b

# 生成 token 预算（本地默认够用；远端长答案可调大）
# TALLY_LLM_MAX_TOKENS=

# thinking：disabled（默认） / enabled —— 结构化调用永远关，仅生成受影响
# TALLY_LLM_THINKING=disabled

# ── 数据/功能（可选）────────────────────────────────────
# SQLite 库路径（默认 ./tally.db）
# TALLY_DB=tally.db

# trend 意图的 LLM 叙述层（v0.6.5 三态）：未设=归纳叙述（默认开，
# 数字闸+方向闸双闸兜底，违例退骨架=保守失败）；enabled=加深度投资
# 分析；off=骨架直出（逃生门，延迟敏感场景）。此前默认关是因为
# 「+90.05% 被说成大幅回落」无机械闸可拦——方向闸补上后翻转
# TALLY_TREND_ANALYSIS=off

# LLM 裁判自测（默认开）：叙述存活后结构化评判 {faithful/on_topic/
# sensitive}——非对称信任（只能否决不能解锁），sensitive 剥句不重写，
# faithful/on_topic 不过有界修复 1 次。off 关闭（省一次 LLM 调用）
# TALLY_SELF_CHECK=off

# 向量第三路 RRF（bge-small-zh @ fastembed，pip install -r requirements-vec.txt
# 且先跑 python -m tally.cli embed）。消融实测（DESIGN-v0.6 §8.3）：
# 数字/口径题上词法双轨已饱和，向量净负贡献——默认关，on 显式实验
# TALLY_VEC=on

# ── v0.7 Memory 三层 ─────────────────────────────────────
# TALLY_MEMORY：L1 事实台账总闸（v0.7 默认开）。off=退回 v0.6.5 无记忆
# 行为（逃生门）。写闸=verify pass ∧ 口径闸未触发；读不豁免——命中
# 重组的答案当场过 verify（DESIGN-v0.7 §7.4）。eval 默认隔离台账，
# TALLY_EVAL_MEMORY=on 显式放开（记忆专项评估）
# TALLY_MEMORY=off
# TALLY_EVAL_MEMORY=on
